# Names of every environment variable Sauti reads. No values here.
# Copy to .env (never committed) and fill in locally, or set them in the host.

# Runtime
SPRING_PROFILES_ACTIVE=

# Database (demo and production; dev uses compose.yaml)
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
# DATABASE_USERNAME above is the app's login, a member of the sauti_app role, for example:
#   create role sauti_login login password '...' in role sauti_app;
# Flyway uses the database owner. The first deployment runs migrations before that login exists,
# so create the sauti_app role's login right after the first migration.
FLYWAY_USERNAME=
FLYWAY_PASSWORD=

# Set to native only behind a trusted proxy that sets X-Forwarded-For; otherwise leave empty.
FORWARD_HEADERS_STRATEGY=

# Encryption (phase 1): 32 random bytes each, Base64, two different keys.
# Make one with: openssl rand -base64 32. Losing APP_ENCRYPTION_KEY makes encrypted data unreadable.
APP_ENCRYPTION_KEY=
HASH_KEY=

# First admin account (phase 1): used only while there are no staff accounts.
# The password must be at least 12 characters and is changed at first login.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=

# Audio storage, S3-compatible (phase 3)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# Groq: transcription and AI summary (phases 3 and 5)
GROQ_API_KEY=
# Local development only: fake (default) or groq. With groq, recorded audio leaves this computer.
TRANSCRIPTION_PROVIDER=
AI_PROVIDER=

# Azure text to speech (phase 7, optional)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Safaricom Daraja M-Pesa (phase 7)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
